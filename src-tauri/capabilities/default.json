{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "store:default",
    "global-shortcut:allow-register",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/Pictures/Stickers/**"]
    }
  ]
}