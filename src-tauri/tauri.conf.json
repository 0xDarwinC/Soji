{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soji",
  "identifier": "com.soji.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "soji",
        "label": "main",
        "width": 800,
        "height": 600,
        "decorations": false,
        "fullscreen": false,
        "resizable": true,
        "minWidth": 260,
        "maxWidth": 800,
        "minHeight": 475,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"] 
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "bin/ffmpeg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gist.githubusercontent.com/0xDarwinC/af72302470d57e33d9eb22409523a9a7/raw/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDNTM4QzNDRUIwOEY4NTEKUldSUitBanJQSXhUREdMdGhDRGd1ZUJXTXYvR2w2aGpUNDFnZVYwSG9YR0RlOU9vdzJONkRnazQK" 
    }
  } 
}
